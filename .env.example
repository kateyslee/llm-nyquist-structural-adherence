# Gemini (use one of these key names)
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Model id (must be enabled for your API key / billing tier). If you see 429 / limit: 0, try another.
# GEMINI_MODEL=gemini-2.5-flash
# Optional pause between Gemini calls in a batch (also: --sleep-between-llm 65)
# GEMINI_SLEEP_BETWEEN_SEC=65

# --- Free local Qwen (Ollama) — use: python run_batch.py --llm ollama-qwen ...
# Defaults: http://127.0.0.1:11434/v1 + qwen2.5-coder:7b
# Install: https://ollama.com then: ollama pull qwen2.5-coder:7b
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5-coder:7b
# OLLAMA_API_KEY=ollama

# Optional: generic OpenAI-compatible API (use: --llm openai-compat)
# OPENAI_API_BASE=https://api.example.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Nyquist: CMU Mac install puts the CLI inside NyquistIDE.app (not on PATH):
# NYQUIST_BIN=/Users/YOU/Applications/NyquistIDE.app/Contents/Java/ny
# Folder with runtime/ + lib/ (usually ~/nyquist from the DMG). Override if needed:
# NYQUIST_HOME=/Users/YOU/nyquist
# Seconds for batch Nyquist render (default 300). Raise if you see nyquist_timeout.
# NYQUIST_TIMEOUT_SEC=600
