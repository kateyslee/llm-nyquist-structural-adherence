; Few-shot for tempo / rhythm tasks: steady BPM in Nyquist SAL (course style).
; Period in seconds = 60.0 / BPM. Extend the envelope pattern to fill the full duration.

define function pulse-train(dur, bpm)
  begin
    set per = 60.0 / bpm
    ; Four beats shown; in real code repeat the same pwl segment to cover `dur`.
    set env = pwl(
      0, 0, 0.02, 1, 0.08, 0,
      per, 0, per + 0.02, 1, per + 0.08, 0,
      2 * per, 0, 2 * per + 0.02, 1, 2 * per + 0.08, 0,
      3 * per, 0, 3 * per + 0.02, 1, 3 * per + 0.08, 0,
      dur, 0
    )
    set click = hzosc(1000.0) ~ dur
    return click * env
  end

define function main()
  begin
    set dur = 12.0
    set bpm = 120.0
    return pulse-train(dur, bpm)
  end

play main()

